{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "teurtask",
  "version": "1.9.0",
  "identifier": "com.novateva.teurtask",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "https://teurtask.com"
  },
  "app": {
    "windows": [
      {
        "title": "teurtask",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["teurtask"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1", "libwebkit2gtk-4.1-0", "libgtk-3-0", "libnotify4"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/tray.png": "icons/tray.png",
      "icons/tray-badge.png": "icons/tray-badge.png",
      "icons/128x128.png": "icons/128x128.png"
    }
  }
}
