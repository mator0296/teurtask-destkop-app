{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "teurtask",
  "version": "1.9.4",
  "identifier": "com.novateva.teurtask",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "https://teurtask.com"
  },
  "app": {
    "windows": [
      {
        "title": "teurtask",
        "create": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["teurtask"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MzNFMjI2RDBBREQ2QjgKUldTNDFxM1FKdUl6cEZoU0xDWjIyS011cFZpQVBiSHgvNzljc0RKYmVxdTFYWVlYaWxQKzRnL3gK",
      "endpoints": [
        "https://github.com/mator0296/teurtask-destkop-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libnotify4",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/tray.png": "icons/tray.png",
      "icons/tray-badge.png": "icons/tray-badge.png",
      "icons/128x128.png": "icons/128x128.png"
    },
    "createUpdaterArtifacts": true
  }
}
